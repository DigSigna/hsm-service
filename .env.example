# HSM Configuration
HSM_MODULE_PATH=/usr/lib/softhsm/libsofthsm2.so
HSM_TOKEN_LABEL=digsigna-token
HSM_SLOT_ID=0x5bdaceb0
HSM_PIN=1234
HSM_MAX_SESSIONS=10

# Server
SERVER_PORT=8080
ENVIRONMENT=development
LOG_LEVEL=info
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s

# Database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=hsm_user
DATABASE_PASSWORD=hsm_password
DATABASE_DBNAME=hsm_service
DATABASE_SSLMODE=disable

# Redis
REDIS_URL=localhost:6379
REDIS_AUDIT_STREAM=hsm-audit-events
REDIS_PASSWORD=
REDIS_DB=0

# Audit
AUDIT_ENABLED=true
AUDIT_SERVICE_URL=http://audit-service:8080

# Security
# JWT_SECRET=your-super-secure-jwt-secret-key-here